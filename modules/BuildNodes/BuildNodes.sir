        Loop
            Condition: jCont
            Body
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.List
                    Returns: m
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.MapSetMut
                    Params: m, "name", ""
