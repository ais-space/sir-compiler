        Instruction
            Type: Instruction
            Role: Content
            Op: Core.ListPush
            Params: blocks, blk
            Returns: blocks
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.ListLen
            Params: blocks
            Returns: openIdx
