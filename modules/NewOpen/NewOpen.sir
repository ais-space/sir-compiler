        Instruction
            Type: Instruction
            Role: Content
            Op: Core.List
            Returns: blk
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.MapSet
            Params: blk, "id", id
            Returns: blk
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.List
            Returns: instrs
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.MapSet
            Params: blk, "instrs", instrs
            Returns: blk
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Map
            Returns: term
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.MapSet
            Params: blk, "term", term
