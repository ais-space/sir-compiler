                            Condition: take
                            TrueBlock
                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Op: Core.Lit
                                    Params: "IR.Load"
                                    Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Eq
            Params: op, "Mem.Write"
            Returns: cW
