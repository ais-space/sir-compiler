    Function
        Name: Compose
        Params: f, g, x
        Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Ctrl.Call
            Params: f, x
            Returns: fx
        Instruction
            Type: Instruction
            Role: Content
            Op: Ctrl.Call
            Params: g, fx
