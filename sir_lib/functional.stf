    Function
        Name: Pipe
        Params: value, fns
        Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.ListLen
            Params: fns
            Returns: n
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lit
            Params: 0
            Returns: i
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lt
            Params: i, n
            Returns: cond
        Loop
            Type: Loop
            Role: Content
            Condition: cond
            Body
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.ListGet
                    Params: fns, i
                    Returns: fname
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Ctrl.Call
                    Params: fname, value
                    Returns: value
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Add
                    Params: i, 1
                    Returns: i
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Lt
                    Params: i, n
                    Returns: cond
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lit
            Params: value
            Returns: out
        Result
            Type: Result
            Role: Content
            State: Ok
            Returns: out
