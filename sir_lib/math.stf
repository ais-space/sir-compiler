    Function
        Name: IsPrime
        Params: n
        Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lt
            Params: n, 2
            Returns: small
        Branch
            Type: Branch
            Role: Content
            Condition: small
            TrueBlock
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.False
                    Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lit
            Params: 2
            Returns: d
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Sqrt
            Params: n
            Returns: srn
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Floor
            Params: srn
            Returns: limit
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Le
            Params: d, limit
            Returns: cond
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.True
            Returns: prime
        Loop
            Type: Loop
            Role: Content
            Condition: cond
            Body
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Mod
                    Params: n, d
                    Returns: r
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Eq
                    Params: r, 0
                    Returns: divisible
                Branch
                    Type: Branch
                    Role: Content
                    Condition: divisible
                    TrueBlock
                        Instruction
                            Type: Instruction
                            Role: Content
                            Op: Core.False
                            Returns: prime
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Add
                    Params: d, 1
                    Returns: d
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Le
                    Params: d, limit
                    Returns: cond
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lit
            Params: prime
            Returns: out
        Result
            Type: Result
            Role: Content
            State: Ok
            Returns: out

