    Function
        Name: Median
        Params: list
        Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Ctrl.Call
            Params: Sort, list
            Returns: sorted
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.ListLen
            Params: sorted
            Returns: n
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Lit
            Params: 2
            Returns: two
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Mod
            Params: n, two
            Returns: rem
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.Eq
            Params: rem, 0
            Returns: even
        Branch
            Type: Branch
            Role: Content
            Condition: even
            TrueBlock
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.IntDiv
                    Params: n, two
                    Returns: mid
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Sub
                    Params: mid, 1
                    Returns: mid1
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.ListGet
                    Params: sorted, mid
                    Returns: a
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.ListGet
                    Params: sorted, mid1
                    Returns: b
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Add
                    Params: a, b
                    Returns: sum
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.Div
                    Params: sum, two
                    Returns: out
            FalseBlock
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.IntDiv
                    Params: n, two
                    Returns: mid
                Instruction
                    Type: Instruction
                    Role: Content
                    Op: Core.ListGet
                    Params: sorted, mid
                    Returns: out
        Result
            Type: Result
            Role: Content
            State: Ok
            Returns: out
