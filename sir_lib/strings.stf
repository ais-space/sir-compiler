            Type: Instruction
            Role: Content
            Op: Core.StrEndsWith
            Params: s, suf
            Returns: out
        Result
            Type: Result
            Role: Content
            State: Ok
            Returns: out

    Function
        Name: ContainsStr
        Params: s, sub
        Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.StrContains
            Params: s, sub
            Returns: out
        Result
            Type: Result
            Role: Content
            State: Ok
            Returns: out

    Function
        Name: ReplaceStr
        Params: s, old, new
        Returns: out
        Instruction
            Type: Instruction
            Role: Content
            Op: Core.StrReplace
            Params: s, old, new
